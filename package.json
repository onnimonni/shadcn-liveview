{
  "name": "shadcn-liveview",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "bun tools/vendor.mjs",
    "verify:upstream": "bun tools/verify-upstream.mjs",
    "generate": "bash tools/generate.sh",
    "test:tools": "tsx --test test/*.test.ts",
    "dump:phoenix": "mix run -e 'File.write!(\"priv/phoenix_ssr.json\", ShadcnLiveview.Gallery.dump_all())'",
    "test:parity": "mix assets.build && bun run dump:phoenix && tsx tools/parity.tsx",
    "test:browser": "bash tools/test-browser.sh",
    "test:a11y": "bash tools/test-accessibility.sh",
    "audit:visual": "bun tools/screenshot-review.ts",
    "test": "bun run generate && mix quality && mix assets.build && bun run test:tools && mix test && bun run dump:phoenix && tsx tools/parity.tsx",
    "build:assets": "mix assets.build",
    "check:elixir": "mix quality"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.52.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.14.2",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "react-hook-form": "^7.65.0",
    "@hookform/resolvers": "^5.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "7.29.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.10",
    "parse5": "^8.0.0",
    "shadcn": "4.21.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "@radix-ui/react-portal@1.1.18": "patches/@radix-ui%2Freact-portal@1.1.18.patch"
  }
}
