{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@radix-ui/react-portal": ["./tools/ssr-portal.tsx"],
      "@/registry/radix-nova/ui/*": ["./vendor/shadcn/ui/*"],
      "@/registry/radix-nova/hooks/*": ["./vendor/shadcn/hooks/*"],
      "@/app/*": ["./vendor/shadcn/app/*"],
      "@/ui/*": ["./vendor/shadcn/ui/*"],
      "@/*": ["./vendor/shadcn/*"]
    }
  },
  "include": ["tools", "test", "vendor/shadcn"]
}
